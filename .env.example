# Salin bagian yang sesuai ke file .env di masing-masing folder.
# File .env JANGAN di-commit (sudah ada di .gitignore).

# ---------- backend/.env ----------
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rivora
JWT_SECRET=ganti-dengan-string-acak

# AI vision: model multimodal, keluaran JSON (docs/RENCANA_FINAL.md bagian 5)
AI_API_KEY=
AI_MODEL=

# Firebase Cloud Messaging: path ke file service account (file-nya JANGAN di-commit)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Open-Meteo tidak butuh API key
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# 1 = pakai hasil AI tersimpan untuk foto demo (docs/RENCANA_FINAL.md bagian 12)
DEMO_MODE=0

# ---------- dashboard/.env ----------
VITE_API_URL=http://localhost:3000

# ---------- mobile ----------
# Flutter tidak membaca .env. Jalankan dengan:
#   flutter run --dart-define=API_URL=http://<IP-laptop>:3000
