# Dasbor membaca .env di AKAR repo (vite.config.js: envDir '..'), bukan file di folder ini.
# Tambahkan baris di bawah ke .env akar (jangan di-commit). Hanya variabel VITE_ yang sampai ke browser.

# Alamat backend Express
VITE_API_URL=http://localhost:3000

# 1 = pakai data contoh di src/mocks (backend belum siap), 0 = panggil backend asli
VITE_USE_MOCK=0

# Kelurahan yang ditampilkan dasbor
VITE_KELURAHAN_ID=1
